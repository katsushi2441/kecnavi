[Unit]
Description=Kurage 通報先ナビ (kecnavi) :18381
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kojima/work/kecnavi
ExecStart=/home/kojima/work/kecnavi/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 18381
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
